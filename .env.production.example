# Copy to .env.production; generate each secret independently with openssl rand -hex 32.
# Images are built on another Linux amd64 machine, then loaded or pulled on the server.
PROD_SERVER_IMAGE=deepecho-server:release-resource-1
PROD_VARIFY_IMAGE=deepecho-varify:release-resource-1
PROD_MYSQL_PASSWORD=
PROD_MYSQL_ROOT_PASSWORD=
PROD_REDIS_PASSWORD=
PROD_GATE_STATUS_TOKEN=
PROD_GATE_VARIFY_TOKEN=
PROD_PEER_TOKEN=
# Preserve the EXISTING key when migrating existing encrypted files.
PROD_FILE_KEY=
# HTTPS URL returned by Gate; include this path and omit the trailing slash.
PROD_RESOURCE_BASE_URL=https://api.deepecho.top/api/resources/v1
PROD_EMAIL_USER=
PROD_EMAIL_PASSWORD=
PROD_SMTP_HOST=
PROD_SMTP_PORT=465
PROD_SMTP_SECURE=true
