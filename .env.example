# C++ services read these variables and let them override the INI values.
CHAT_REDIS_HOST=127.0.0.1
CHAT_REDIS_PORT=6379
CHAT_REDIS_PASSWORD=
CHAT_REDIS_USER=default
CHAT_MYSQL_HOST=127.0.0.1
CHAT_MYSQL_PORT=3306
CHAT_MYSQL_PASSWORD=
CHAT_MYSQL_USER=root
CHAT_MYSQL_SCHEMA=wgt

# C++ gRPC clients and servers: insecure, tls, or mtls.
CHAT_GRPC_TLS_MODE=mtls
CHAT_GRPC_CA_CERT=/etc/distributed-chat/tls/ca.crt
CHAT_GRPC_CERT=/etc/distributed-chat/tls/service.crt
CHAT_GRPC_KEY=/etc/distributed-chat/tls/service.key

# VarifyServer
VARIFY_BIND_ADDRESS=0.0.0.0:5000
VARIFY_GRPC_TLS_MODE=mtls
VARIFY_GRPC_CA_CERT=/etc/distributed-chat/tls/ca.crt
VARIFY_GRPC_CERT=/etc/distributed-chat/tls/varify.crt
VARIFY_GRPC_KEY=/etc/distributed-chat/tls/varify.key
VARIFY_REDIS_HOST=127.0.0.1
VARIFY_REDIS_PORT=6379
VARIFY_REDIS_PASSWORD=
VARIFY_EMAIL_USER=sender@example.com
VARIFY_EMAIL_PASSWORD=
VARIFY_SMTP_HOST=smtp.example.com
VARIFY_SMTP_PORT=465
VARIFY_SMTP_SECURE=true
