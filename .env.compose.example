# Local development only. Copy to .env before running Docker Compose.
CHAT_REDIS_HOST=127.0.0.1
CHAT_REDIS_PORT=6379
CHAT_REDIS_USER=default
CHAT_REDIS_PASSWORD=replace-with-a-random-local-password

CHAT_MYSQL_HOST=127.0.0.1
CHAT_MYSQL_PORT=3306
CHAT_MYSQL_USER=chat
CHAT_MYSQL_PASSWORD=replace-with-a-random-local-password
CHAT_MYSQL_ROOT_PASSWORD=replace-with-a-different-random-local-password
CHAT_MYSQL_SCHEMA=wgt

VARIFY_REDIS_HOST=127.0.0.1
VARIFY_REDIS_PORT=6379
VARIFY_REDIS_PASSWORD=replace-with-a-random-local-password

CHAT_GATE_STATUS_TOKEN=replace-with-a-random-status-token
CHAT_GATE_VARIFY_TOKEN=replace-with-a-random-varify-token
CHAT_PEER_RPC_TOKEN=replace-with-a-random-peer-token
CHAT_FILE_STORAGE_ROOT=/var/lib/distributed-chat/files
# 可用 `openssl rand -hex 32` 生成；所有 ChatServer 必须保持一致。
CHAT_FILE_STORAGE_KEY=replace-with-64-hexadecimal-characters
