# 将这些公网端点字段合并到 status.ini 的对应配置节。
# Host/Port 保留为本地开发的后备配置；PublicHost/PublicPort
# 是返回给桌面客户端的公网地址。

[chatservers]
Name = chatserver1,chatserver2

[chatserver1]
Name = chatserver1
PublicHost = chat1.chat.example.com
PublicPort = 443
Transport = tls
TLSName = chat1.chat.example.com

[chatserver2]
Name = chatserver2
PublicHost = chat2.chat.example.com
PublicPort = 443
Transport = tls
TLSName = chat2.chat.example.com
